@page "/mesh"
@inject HttpClient Http

@* Pillar 3: mesh viz + MST route tracking (7.1–7.2); AVL history; traversal/MST copy in 7.4. *@

<PageTitle>Mesh topology — Smart-X</PageTitle>

<section class="mesh">
    <header class="mesh-header">
        <p class="mesh-kicker">Final PoE · Network Topology and Mesh Routing</p>
        <h1>Topology dashboard</h1>
        <p class="mesh-lead">
            Live wireless mesh with online/down encoding. Select a sensor by id or MAC
            to highlight its Prim MST hop path toward the gateway.
        </p>
    </header>

    <div class="sx-form-actions mesh-toolbar">
        <button type="button" disabled="@busy" @onclick="ReloadMeshAsync">Refresh mesh</button>
    </div>

    @if (loadError is not null)
    {
        <p class="mesh-error" role="alert">@loadError</p>
    }

    @if (topology is not null)
    {
        <article class="mesh-panel">
            <h2>Active mesh</h2>
            <dl class="mesh-meta">
                <div>
                    <dt>Nodes</dt>
                    <dd>@topology.NodeCount</dd>
                </div>
                <div>
                    <dt>Links</dt>
                    <dd>@topology.EdgeCount</dd>
                </div>
                <div>
                    <dt>Online</dt>
                    <dd class="mesh-ok">@topology.OnlineNodeCount</dd>
                </div>
                <div>
                    <dt>Down</dt>
                    <dd class="@(topology.OfflineNodeCount > 0 ? "mesh-bad" : null)">@topology.OfflineNodeCount</dd>
                </div>
            </dl>

            <div class="mesh-legend" aria-hidden="true">
                <span class="mesh-legend-item"><span class="mesh-swatch mesh-swatch-gateway"></span> Gateway</span>
                <span class="mesh-legend-item"><span class="mesh-swatch mesh-swatch-online"></span> Online ESP32</span>
                <span class="mesh-legend-item"><span class="mesh-swatch mesh-swatch-down"></span> Down</span>
                <span class="mesh-legend-item"><span class="mesh-swatch mesh-swatch-link"></span> Wireless link</span>
                <span class="mesh-legend-item"><span class="mesh-swatch mesh-swatch-path"></span> Selected route</span>
            </div>

            <form class="sx-form mesh-route-form" @onsubmit="TrackRouteAsync" @onsubmit:preventDefault>
                <label>
                    Track sensor (id)
                    <select @bind="routeDeviceId" @bind:after="OnRouteDeviceChangedAsync">
                        <option value="">Select device</option>
                        @foreach (var node in topology.Nodes.Where(n => n.Kind != MeshNodeKind.Gateway))
                        {
                            <option value="@node.Id">@node.Id@(string.IsNullOrEmpty(node.MacAddress) ? "" : $" · {node.MacAddress}")</option>
                        }
                    </select>
                </label>
                <label>
                    Or MAC
                    <input @bind="macQuery" placeholder="e.g. AA:BB:…" />
                </label>
                <div class="sx-form-actions">
                    <button type="submit" disabled="@busy">Track route to gateway</button>
                    <button type="button" disabled="@busy || routePath.Count == 0" @onclick="ClearRoute">Clear route</button>
                </div>
            </form>

            @if (routeMessage is not null)
            {
                <p class="@(routePath.Count > 0 ? "mesh-hint" : "mesh-error")" role="status">@routeMessage</p>
            }

            @if (routePath.Count > 0)
            {
                <p class="mesh-route-path">
                    <span class="mesh-route-label">MST hop path</span>
                    @string.Join(" → ", routePath)
                </p>
            }

            <div class="mesh-canvas-wrap">
                <svg class="mesh-canvas" viewBox="0 0 @SvgWidth @SvgHeight" role="img" aria-label="Smart-X mesh topology">
                    @foreach (var edge in topology.Edges)
                    {
                        if (!TryGetPoint(edge.FromId, out var from) || !TryGetPoint(edge.ToId, out var to))
                        {
                            continue;
                        }

                        var onPath = IsPathEdge(edge.FromId, edge.ToId);
                        var downLink = IsDown(edge.FromId) || IsDown(edge.ToId);
                        var linkCss = onPath
                            ? "mesh-link mesh-link-path"
                            : downLink ? "mesh-link mesh-link-dim" : "mesh-link";
                        <line class="@linkCss"
                              x1="@from.X" y1="@from.Y" x2="@to.X" y2="@to.Y" />
                    }

                    @foreach (var node in topology.Nodes)
                    {
                        if (!TryGetPoint(node.Id, out var point))
                        {
                            continue;
                        }

                        var css = NodeCss(node);
                        <g class="mesh-vertex" transform="translate(@point.X @point.Y)"
                           @onclick="() => SelectRouteNodeAsync(node.Id)" @onclick:stopPropagation="true">
                            <circle class="@css" r="@(node.Kind == MeshNodeKind.Gateway ? 16 : 11)" />
                            <title>@NodeTitle(node) — click to track</title>
                            <text class="mesh-vertex-label" y="28">@ShortLabel(node.Id)</text>
                        </g>
                    }
                </svg>
            </div>

            <div class="table-wrap">
                <table class="mesh-table">
                    <thead>
                        <tr>
                            <th>Node</th>
                            <th>MAC</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Freshness</th>
                            <th>Neighbours</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var node in topology.Nodes)
                        {
                            var onPath = routeSet.Contains(node.Id);
                            <tr class="@(node.IsOnline ? null : "mesh-row-down") @(onPath ? "mesh-row-path" : null)">
                                <td>@node.Id</td>
                                <td>@(string.IsNullOrEmpty(node.MacAddress) ? "—" : node.MacAddress)</td>
                                <td>@(node.Kind == MeshNodeKind.Gateway ? "Gateway" : node.Category?.ToString() ?? "Sensor")</td>
                                <td>@(node.IsOnline ? "Online" : "Down")</td>
                                <td>@node.Freshness</td>
                                <td>@node.NeighbourCount</td>
                                <td>
                                    @if (node.Kind != MeshNodeKind.Gateway)
                                    {
                                        <button type="button" class="mesh-link-btn" disabled="@busy"
                                                @onclick="() => SelectRouteNodeAsync(node.Id)">Track</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    }

    <header class="mesh-subheader">
        <h2>AVL history range</h2>
        <p class="mesh-lead">
            Timestamped samples via the per-device AVL index (range walk ≈ log n + k).
        </p>
    </header>

    <form class="sx-form mesh-range" @onsubmit="RunRangeQueryAsync" @onsubmit:preventDefault>
        <label>
            Sensor
            <select @bind="selectedDeviceId">
                <option value="">Select device</option>
                @foreach (var sensor in sensors)
                {
                    <option value="@sensor.Id">@sensor.Id (@sensor.Category)</option>
                }
            </select>
        </label>
        <label>
            Metric (optional)
            <input @bind="metricFilter" placeholder="e.g. Moisture" />
        </label>
        <label>
            From (UTC local)
            <input type="datetime-local" @bind="fromLocal" />
        </label>
        <label>
            To (UTC local)
            <input type="datetime-local" @bind="toLocal" />
        </label>
        <div class="sx-form-actions">
            <button type="submit" disabled="@busy">Run AVL range query</button>
            <button type="button" disabled="@busy" @onclick="UseFullTreeWindowAsync">Use full tree window</button>
        </div>
    </form>

    @if (rangeResult is not null)
    {
        <article class="mesh-panel">
            <h2>Range result — @rangeResult.DeviceId</h2>
            <dl class="mesh-meta">
                <div>
                    <dt>Matches</dt>
                    <dd>@rangeResult.MatchCount</dd>
                </div>
                <div>
                    <dt>AVL tree size</dt>
                    <dd>@rangeResult.TreeSize</dd>
                </div>
                <div>
                    <dt>Nodes visited</dt>
                    <dd>@rangeResult.NodesVisited</dd>
                </div>
                <div>
                    <dt>Metric filter</dt>
                    <dd>@(rangeResult.MetricFilter ?? "any")</dd>
                </div>
            </dl>
            <p class="mesh-hint">
                Efficiency: visited @rangeResult.NodesVisited node(s) of @rangeResult.TreeSize stored
                @(rangeResult.TreeSize > 0 && rangeResult.NodesVisited < rangeResult.TreeSize
                    ? "— narrower than a full list scan."
                    : ".")
            </p>

            @if (rangeResult.Points.Count == 0)
            {
                <p class="mesh-hint">No samples in this window.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="mesh-table">
                        <thead>
                            <tr>
                                <th>Time (UTC)</th>
                                <th>Seq</th>
                                <th>Metric</th>
                                <th>Value</th>
                                <th>Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var point in rangeResult.Points)
                            {
                                <tr>
                                    <td>@point.Timestamp.UtcDateTime.ToString("u")</td>
                                    <td>@point.Sequence</td>
                                    <td>@point.Metric</td>
                                    <td>
                                        @(point.NumericValue?.ToString("0.###")
                                          ?? (point.BoolValue is { } flag ? (flag ? "active" : "inactive") : "—"))
                                    </td>
                                    <td>@point.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }

    <p class="mesh-ops">
        <a href="">Startup menu</a>
        ·
        <a href="telemetry">Telemetry</a>
        ·
        <a href="commands">Command stream</a>
    </p>
</section>

@code {
    private const double SvgWidth = 900;
    private const double SvgHeight = 520;

    private List<SensorResponse> sensors = [];
    private MeshTopologySnapshotResponse? topology;
    private MeshMstResponse? mst;
    private Dictionary<string, Point> layout = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> parentByNode = new(StringComparer.OrdinalIgnoreCase);
    private List<string> routePath = [];
    private HashSet<string> routeSet = new(StringComparer.OrdinalIgnoreCase);
    private string routeDeviceId = "sx-env-rack1-moist";
    private string macQuery = string.Empty;
    private string? routeMessage;
    private string selectedDeviceId = "sx-env-rack1-moist";
    private string metricFilter = "Moisture";
    private DateTime? fromLocal;
    private DateTime? toLocal;
    private TelemetryRangeHistoryResponse? rangeResult;
    private string? loadError;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await ReloadMeshAsync();
        try
        {
            var list = await Http.GetFromJsonAsync<SensorListResponse>("api/sensors", GatewayJson.Options);
            sensors = list?.Sensors ?? [];
            if (sensors.Count > 0 && sensors.All(s => s.Id != selectedDeviceId))
            {
                selectedDeviceId = sensors[0].Id;
                routeDeviceId = selectedDeviceId;
                metricFilter = string.Empty;
            }

            if (!string.IsNullOrWhiteSpace(routeDeviceId))
            {
                await TrackRouteAsync();
            }
        }
        catch (HttpRequestException)
        {
            loadError ??= "Gateway unreachable. Start SmartX.Api and reload.";
        }
    }

    private async Task ReloadMeshAsync()
    {
        busy = true;
        loadError = null;
        try
        {
            topology = await Http.GetFromJsonAsync<MeshTopologySnapshotResponse>(
                "api/mesh/topology",
                GatewayJson.Options);
            mst = await Http.GetFromJsonAsync<MeshMstResponse>(
                "api/mesh/mst?onlineOnly=true",
                GatewayJson.Options);

            if (topology is null)
            {
                loadError = "Gateway returned an empty mesh topology.";
                layout = new Dictionary<string, Point>(StringComparer.OrdinalIgnoreCase);
                parentByNode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                return;
            }

            layout = BuildLayout(topology);
            parentByNode = (mst?.ParentHops ?? [])
                .ToDictionary(h => h.NodeId, h => h.ParentId, StringComparer.OrdinalIgnoreCase);

            if (!string.IsNullOrWhiteSpace(routeDeviceId))
            {
                RebuildRoute(routeDeviceId);
            }
        }
        catch (HttpRequestException)
        {
            topology = null;
            mst = null;
            layout = new Dictionary<string, Point>(StringComparer.OrdinalIgnoreCase);
            parentByNode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            loadError = "Gateway unreachable. Start SmartX.Api and reload.";
        }
        catch (Exception)
        {
            topology = null;
            mst = null;
            layout = new Dictionary<string, Point>(StringComparer.OrdinalIgnoreCase);
            parentByNode = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            loadError = "Could not load the mesh topology.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnRouteDeviceChangedAsync()
    {
        macQuery = string.Empty;
        if (!string.IsNullOrWhiteSpace(routeDeviceId))
        {
            selectedDeviceId = routeDeviceId;
            await TrackRouteAsync();
        }
    }

    private async Task SelectRouteNodeAsync(string nodeId)
    {
        if (string.Equals(nodeId, MeshGraph.GatewayNodeId, StringComparison.OrdinalIgnoreCase))
        {
            routeMessage = "Gateway is the route destination — pick an ESP32 sensor.";
            return;
        }

        routeDeviceId = nodeId;
        selectedDeviceId = nodeId;
        macQuery = string.Empty;
        await TrackRouteAsync();
    }

    private Task TrackRouteAsync()
    {
        routeMessage = null;

        if (!string.IsNullOrWhiteSpace(macQuery) && topology is not null)
        {
            var mac = NormalizeMac(macQuery);
            var match = topology.Nodes.FirstOrDefault(n =>
                !string.IsNullOrEmpty(n.MacAddress) &&
                NormalizeMac(n.MacAddress) == mac);
            if (match is null)
            {
                ClearRoute();
                routeMessage = $"No mesh node matches MAC '{macQuery.Trim()}'.";
                return Task.CompletedTask;
            }

            routeDeviceId = match.Id;
            selectedDeviceId = match.Id;
        }

        if (string.IsNullOrWhiteSpace(routeDeviceId))
        {
            ClearRoute();
            routeMessage = "Select a sensor id or enter a MAC to track.";
            return Task.CompletedTask;
        }

        RebuildRoute(routeDeviceId);
        return Task.CompletedTask;
    }

    private void RebuildRoute(string deviceId)
    {
        routePath = [];
        routeSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        if (parentByNode.Count == 0 && mst is null)
        {
            routeMessage = "MST parent hops are not loaded yet — refresh the mesh.";
            return;
        }

        if (topology?.Nodes.All(n =>
                !string.Equals(n.Id, deviceId, StringComparison.OrdinalIgnoreCase)) == true)
        {
            routeMessage = $"Sensor '{deviceId}' is not in the mesh.";
            return;
        }

        if (!parentByNode.ContainsKey(deviceId) &&
            !string.Equals(deviceId, mst?.RootId, StringComparison.OrdinalIgnoreCase))
        {
            // Online-only MST omits down / cut-off nodes.
            ClearRoute();
            routeMessage =
                $"No live MST route for '{deviceId}' (node may be down or cut off). " +
                "Try another sensor or refresh after recovery.";
            return;
        }

        var path = new List<string> { deviceId };
        var current = deviceId;
        var guard = 0;
        var root = mst?.RootId ?? MeshGraph.GatewayNodeId;

        while (!string.Equals(current, root, StringComparison.OrdinalIgnoreCase))
        {
            if (!parentByNode.TryGetValue(current, out var parent))
            {
                ClearRoute();
                routeMessage = $"Incomplete MST parent chain for '{deviceId}'.";
                return;
            }

            path.Add(parent);
            current = parent;
            if (++guard > parentByNode.Count + 2)
            {
                ClearRoute();
                routeMessage = "Route reconstruction looped — refresh the mesh.";
                return;
            }
        }

        // Telemetry flow: sensor → … → gateway
        routePath = path;
        routeSet = path.ToHashSet(StringComparer.OrdinalIgnoreCase);
        routeMessage =
            $"Tracked {deviceId}: {path.Count - 1} hop(s) on the power-efficient MST backbone.";
    }

    private void ClearRoute()
    {
        routePath = [];
        routeSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        routeMessage = null;
    }

    private bool IsPathEdge(string a, string b)
    {
        if (routePath.Count < 2)
        {
            return false;
        }

        for (var i = 0; i < routePath.Count - 1; i++)
        {
            var x = routePath[i];
            var y = routePath[i + 1];
            if ((string.Equals(a, x, StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(b, y, StringComparison.OrdinalIgnoreCase)) ||
                (string.Equals(a, y, StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(b, x, StringComparison.OrdinalIgnoreCase)))
            {
                return true;
            }
        }

        return false;
    }

    private static string NormalizeMac(string value)
        => value.Trim().Replace("-", string.Empty, StringComparison.Ordinal)
            .Replace(":", string.Empty, StringComparison.Ordinal)
            .ToUpperInvariant();

    private async Task UseFullTreeWindowAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            loadError = "Select a sensor first.";
            return;
        }

        fromLocal = null;
        toLocal = null;
        await RunRangeQueryAsync();
    }

    private async Task RunRangeQueryAsync()
    {
        loadError = null;
        rangeResult = null;

        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            loadError = "Select a sensor before running a range query.";
            return;
        }

        busy = true;
        try
        {
            var query = new List<string>();
            if (fromLocal is { } from)
            {
                query.Add("from=" + Uri.EscapeDataString(ToUtcIso(from)));
            }

            if (toLocal is { } to)
            {
                query.Add("to=" + Uri.EscapeDataString(ToUtcIso(to)));
            }

            if (!string.IsNullOrWhiteSpace(metricFilter))
            {
                query.Add("metric=" + Uri.EscapeDataString(metricFilter.Trim()));
            }

            var path = $"api/sensors/{Uri.EscapeDataString(selectedDeviceId.Trim())}/history/range";
            if (query.Count > 0)
            {
                path += "?" + string.Join("&", query);
            }

            rangeResult = await Http.GetFromJsonAsync<TelemetryRangeHistoryResponse>(path, GatewayJson.Options);
            if (rangeResult is null)
            {
                loadError = "Gateway returned an empty range payload.";
            }
        }
        catch (HttpRequestException)
        {
            loadError = "Gateway unreachable. Start SmartX.Api and try again.";
        }
        catch (Exception)
        {
            loadError = "The AVL range query failed.";
        }
        finally
        {
            busy = false;
        }
    }

    private bool TryGetPoint(string id, out Point point)
        => layout.TryGetValue(id, out point!);

    private bool IsDown(string id)
        => topology?.Nodes.FirstOrDefault(n =>
               string.Equals(n.Id, id, StringComparison.OrdinalIgnoreCase)) is { IsOnline: false };

    private string NodeCss(MeshNodeResponse node)
    {
        var onPath = routeSet.Contains(node.Id);
        if (node.Kind == MeshNodeKind.Gateway)
        {
            return onPath ? "mesh-node mesh-node-gateway mesh-node-path" : "mesh-node mesh-node-gateway";
        }

        if (!node.IsOnline)
        {
            return onPath ? "mesh-node mesh-node-down mesh-node-path" : "mesh-node mesh-node-down";
        }

        return onPath ? "mesh-node mesh-node-online mesh-node-path" : "mesh-node mesh-node-online";
    }

    private static string NodeTitle(MeshNodeResponse node)
    {
        var role = node.Kind == MeshNodeKind.Gateway ? "Gateway" : node.Category?.ToString() ?? "Sensor";
        var status = node.IsOnline ? "online" : "down";
        return $"{node.Id} · {role} · {status} · {node.NeighbourCount} neighbours";
    }

    private static string ShortLabel(string id)
    {
        if (string.Equals(id, MeshGraph.GatewayNodeId, StringComparison.OrdinalIgnoreCase))
        {
            return "gateway";
        }

        var parts = id.Split('-', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length <= 2 ? id : string.Join('-', parts.TakeLast(2));
    }

    private static Dictionary<string, Point> BuildLayout(MeshTopologySnapshotResponse snapshot)
    {
        var map = new Dictionary<string, Point>(StringComparer.OrdinalIgnoreCase);
        var cx = SvgWidth / 2;
        var cy = SvgHeight / 2;
        map[snapshot.GatewayNodeId] = new Point(cx, cy);

        var others = snapshot.Nodes
            .Where(n => n.Kind != MeshNodeKind.Gateway)
            .OrderBy(n => n.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (others.Count == 0)
        {
            return map;
        }

        var radius = Math.Min(SvgWidth, SvgHeight) * 0.38;
        for (var i = 0; i < others.Count; i++)
        {
            var angle = (2 * Math.PI * i / others.Count) - (Math.PI / 2);
            map[others[i].Id] = new Point(
                cx + radius * Math.Cos(angle),
                cy + radius * Math.Sin(angle));
        }

        return map;
    }

    private static string ToUtcIso(DateTime local)
    {
        var unspecified = DateTime.SpecifyKind(local, DateTimeKind.Local);
        return unspecified.ToUniversalTime().ToString("o");
    }

    private sealed record Point(double X, double Y);
}
