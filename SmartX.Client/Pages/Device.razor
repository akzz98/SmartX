@page "/telemetry/devices/{DeviceId}"
@inject HttpClient Http

@* Progressive Disclosure level 2: what happened on this ESP32? Display gateway state; do not re-detect it. *@

<PageTitle>@(detail?.Sensor.Id ?? DeviceId) — Smart-X</PageTitle>

<section class="device">
    <p class="device-kicker">Progressive Disclosure · level 2</p>
    <p>
        <a href="telemetry">Overview</a>
        ·
        <a href="telemetry/fleet">Fleet</a>
    </p>

    @if (notFound)
    {
        <p class="device-error" role="alert">Device '@DeviceId' is not registered on this gateway.</p>
    }
    else if (loadError is not null)
    {
        <p class="device-error" role="alert">@loadError</p>
    }
    else if (detail is null)
    {
        <p>Loading device…</p>
    }
    else
    {
        var sensor = detail.Sensor;
        <header class="device-header">
            <h1>@sensor.Id</h1>
            <p class="device-lead">What happened on this device? Health and freshness come from the gateway.</p>
            <p>
                <a href="telemetry/devices/@sensor.Id/history">Open history (level 3)</a>
            </p>
        </header>

        <div class="status-row">
            <article class="panel">
                <h2>Status</h2>
                <dl>
                    <div><dt>Health</dt><dd>@sensor.Health</dd></div>
                    <div><dt>Freshness</dt><dd>@sensor.Freshness</dd></div>
                    <div><dt>Last seen</dt><dd>@(sensor.LastSeenAt?.ToString("u") ?? "never")</dd></div>
                </dl>
            </article>
            <article class="panel">
                <h2>Latest value</h2>
                <p>@LatestValueText</p>
                @if (detail.LatestEnvironmentalDelta is { } delta)
                {
                    <p>Environmental delta (current − previous): @delta.Value.ToString("0.###") @delta.Metric</p>
                }
            </article>
            <article class="panel">
                <h2>Thresholds (gateway bands)</h2>
                <p>@ThresholdText</p>
                <p class="hint">Live ≤ 60s · Aging ≤ 5 min · Stale ≤ 15 min · then Disconnected.</p>
            </article>
        </div>

        <div class="status-row">
            <article class="panel">
                <h2>Identity and configuration</h2>
                <dl>
                    <div><dt>MAC</dt><dd>@sensor.MacAddress</dd></div>
                    <div><dt>Category</dt><dd>@sensor.Category</dd></div>
                    <div><dt>Registered</dt><dd>@sensor.RegisteredAt.ToString("u")</dd></div>
                    @if (detail.ExpectedIsActive is { } expected)
                    {
                        <div><dt>Commanded actuator</dt><dd>@(expected ? "active / open" : "inactive / closed")</dd></div>
                    }
                </dl>
            </article>
            <article class="panel">
                <h2>Packets and errors</h2>
                <dl>
                    <div><dt>Accepted packets</dt><dd>@(detail.Ingest?.PacketCount ?? 0)</dd></div>
                    <div><dt>Last sequence</dt><dd>@(detail.Ingest?.LastSequence.ToString() ?? "—")</dd></div>
                    <div><dt>Rejected frames</dt><dd>@detail.Rejections.Count</dd></div>
                </dl>
                @if (detail.Rejections.Count > 0)
                {
                    <ul class="reject-list">
                        @foreach (var rejection in detail.Rejections)
                        {
                            <li>@rejection.RejectedAt.ToString("u"): @string.Join(" ", rejection.Errors)</li>
                        }
                    </ul>
                }
            </article>
        </div>

        <article class="panel attachments">
            <h2>Attachments</h2>
            <p class="hint">
                Rack photos, JSON configs and hardware logs stay on this ESP32 profile.
                A rejected upload does not change telemetry or health.
            </p>
            <div class="attach-form">
                <label>
                    Kind
                    <select @bind="selectedKind">
                        <option value="@AttachmentKind.HardwareLog">Hardware log</option>
                        <option value="@AttachmentKind.Configuration">Configuration</option>
                        <option value="@AttachmentKind.Photo">Deployment photo</option>
                    </select>
                </label>
                <InputFile OnChange="OnAttachmentSelected" accept=".log,.txt,.csv,.json,.xml,.conf,.jpg,.jpeg,.png,.webp" />
                <button type="button" disabled="@uploading" @onclick="UploadAttachmentAsync">
                    @(uploading ? "Uploading…" : "Attach file")
                </button>
            </div>
            @if (uploadError is not null)
            {
                <p class="device-error" role="alert">@uploadError</p>
            }
            else if (uploadOk is not null)
            {
                <p class="device-ok">@uploadOk</p>
            }
            @if (detail.Attachments.Count == 0)
            {
                <p>No files attached yet.</p>
            }
            else
            {
                <ul class="attach-list">
                    @foreach (var attachment in detail.Attachments)
                    {
                        <li>
                            <div>
                                <strong>@attachment.FileName</strong>
                                <span> · @KindLabel(attachment.Kind) · @attachment.SizeBytes B · @attachment.StoredAt.ToString("u")</span>
                                <a href="@AttachmentHref(attachment)" target="_blank" rel="noopener">Download</a>
                            </div>
                            @if (attachment.Kind == AttachmentKind.Photo)
                            {
                                <img class="attach-thumb" src="@AttachmentHref(attachment)" alt="@attachment.FileName" />
                            }
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="panel">
            <h2>Location context</h2>
            <p>
                @detail.LocationName (@sensor.LocationNodeId)
                @if (detail.LocationLevel is { } level)
                {
                    <span>· @level</span>
                }
            </p>
            <h3>Related sensors on this node</h3>
            @if (related.Count == 0)
            {
                <p>No other registered devices on this node.</p>
            }
            else
            {
                <ul>
                    @foreach (var neighbour in related)
                    {
                        <li>
                            <a href="telemetry/devices/@neighbour.Id">@neighbour.Id</a>
                            · @neighbour.Category · @neighbour.Health · @neighbour.Freshness
                        </li>
                    }
                </ul>
            }
        </article>
    }
</section>

@code {
    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    private DeviceDetailResponse? detail;
    private TelemetryHistoryResponse? latest;
    private List<SensorResponse> related = [];
    private string? loadError;
    private bool notFound;
    private AttachmentKind selectedKind = AttachmentKind.HardwareLog;
    private IBrowserFile? pendingFile;
    private string? uploadError;
    private string? uploadOk;
    private bool uploading;

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        loadError = null;
        uploadError = null;
        uploadOk = null;
        pendingFile = null;
        detail = null;
        latest = null;
        related = [];

        try
        {
            var encoded = Uri.EscapeDataString(DeviceId);
            using var response = await Http.GetAsync($"api/sensors/{encoded}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                notFound = true;
                return;
            }

            response.EnsureSuccessStatusCode();
            detail = await response.Content.ReadFromJsonAsync<DeviceDetailResponse>(GatewayJson.Options);
            if (detail is null)
            {
                loadError = "The gateway returned an empty device payload.";
                return;
            }

            latest = await Http.GetFromJsonAsync<TelemetryHistoryResponse>(
                $"api/sensors/{encoded}/history?take=1",
                GatewayJson.Options);

            var neighbours = await Http.GetFromJsonAsync<SensorListResponse>(
                $"api/sensors?locationNodeId={Uri.EscapeDataString(detail.Sensor.LocationNodeId)}",
                GatewayJson.Options);
            related = (neighbours?.Sensors ?? [])
                .Where(sensor => !string.Equals(sensor.Id, DeviceId, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        catch (HttpRequestException)
        {
            loadError = "Gateway unreachable. Start SmartX.Api (http://localhost:5015) and reload.";
        }
        catch (Exception)
        {
            loadError = "Device details could not be loaded from the gateway.";
        }
    }

    private string LatestValueText
    {
        get
        {
            if (latest is null)
            {
                return "No telemetry stored yet.";
            }

            if (latest.Environmental.Count > 0)
            {
                var packet = latest.Environmental[0];
                return $"{packet.Payload.Value:0.###} {packet.Payload.Metric} · seq {packet.Sequence} · {packet.Timestamp:u}";
            }

            if (latest.Power.Count > 0)
            {
                var packet = latest.Power[0];
                return $"{packet.Payload.Value} {packet.Payload.Metric} · seq {packet.Sequence} · {packet.Timestamp:u}";
            }

            if (latest.Actuator.Count > 0)
            {
                var packet = latest.Actuator[0];
                return $"{packet.Payload.Kind} {(packet.Payload.IsActive ? "active" : "inactive")} · seq {packet.Sequence} · {packet.Timestamp:u}";
            }

            return "No telemetry stored yet.";
        }
    }

    private string ThresholdText => GatewayBands.Describe(latest, detail?.ExpectedIsActive);

    private void OnAttachmentSelected(InputFileChangeEventArgs args)
    {
        pendingFile = args.File;
        uploadError = null;
        uploadOk = null;
    }

    private async Task UploadAttachmentAsync()
    {
        uploadError = null;
        uploadOk = null;
        if (pendingFile is null)
        {
            uploadError = "Choose a configuration file, photo, or hardware log first.";
            return;
        }

        if (pendingFile.Size > AttachmentValidator.MaxBytes)
        {
            uploadError = "Attachments must be 2 MB or smaller.";
            return;
        }

        uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = pendingFile.OpenReadStream(AttachmentValidator.MaxBytes);
            using var fileContent = new StreamContent(stream);
            if (!string.IsNullOrWhiteSpace(pendingFile.ContentType))
            {
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(pendingFile.ContentType);
            }

            content.Add(fileContent, "file", pendingFile.Name);
            content.Add(new StringContent(selectedKind.ToString()), "kind");

            var encoded = Uri.EscapeDataString(DeviceId);
            using var response = await Http.PostAsync($"api/sensors/{encoded}/attachments", content);
            var payload = await response.Content.ReadFromJsonAsync<UploadAttachmentResponse>(GatewayJson.Options);

            if (!response.IsSuccessStatusCode || payload is null || !payload.Succeeded || payload.Attachment is null)
            {
                uploadError = payload?.Errors.Count > 0
                    ? string.Join(" ", payload.Errors)
                    : "The gateway rejected this upload. Telemetry was not changed.";
                return;
            }

            detail!.Attachments.Insert(0, payload.Attachment);
            uploadOk = $"{payload.Attachment.FileName} attached to this sensor.";
            pendingFile = null;
        }
        catch (HttpRequestException)
        {
            uploadError = "Gateway unreachable. Start SmartX.Api (http://localhost:5015) and retry the upload.";
        }
        catch (Exception)
        {
            uploadError = "The upload failed. Telemetry and health on this device were not changed.";
        }
        finally
        {
            uploading = false;
        }
    }

    private string AttachmentHref(AttachmentResponse attachment)
    {
        var root = (Http.BaseAddress?.ToString() ?? "http://localhost:5015/").TrimEnd('/');
        return $"{root}/api/sensors/{Uri.EscapeDataString(DeviceId)}/attachments/{Uri.EscapeDataString(attachment.Id)}";
    }

    private static string KindLabel(AttachmentKind kind) => kind switch
    {
        AttachmentKind.Photo => "photo",
        AttachmentKind.Configuration => "configuration",
        _ => "hardware log"
    };
}
