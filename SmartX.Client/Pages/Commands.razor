@page "/commands"
@inject HttpClient Http

@* Part 2 stream visualisation: queue depths, unique HashSet alerts, recent priority work. *@

<PageTitle>Command stream — Smart-X</PageTitle>

<section class="commands">
    <header class="commands-header">
        <p class="commands-kicker">Part 2 · Real-Time Command Stream</p>
        <h1>Command stream and history</h1>
        <p class="commands-lead">
            Standard FIFO ingest vs critical priority bypass. Filter the fleet by category and
            alert/health state before issuing overrides.
        </p>
    </header>

    <form class="sx-form commands-filter" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
        <label>
            Category
            <select @bind="categoryText">
                <option value="">Any category</option>
                @foreach (var name in Enum.GetNames<SensorCategory>())
                {
                    <option value="@name">@name</option>
                }
            </select>
        </label>
        <label>
            Health
            <select @bind="healthText">
                <option value="">Any health</option>
                @foreach (var name in Enum.GetNames<HealthState>())
                {
                    <option value="@name">@name</option>
                }
            </select>
        </label>
        <label>
            Alert state
            <select @bind="alertScope">
                <option value="any">Any</option>
                <option value="unique">Unique HashSet key active</option>
                <option value="attention">Non-normal health</option>
            </select>
        </label>
        <div class="sx-form-actions">
            <button type="submit">Apply filters</button>
            <button type="button" @onclick="ClearFiltersAsync">Clear</button>
        </div>
    </form>

    <form class="sx-form commands-override" @onsubmit="IssueOverrideAsync" @onsubmit:preventDefault>
        <label>
            Actuator
            <select @bind="overrideDeviceId">
                <option value="">Select valve / pump / relay</option>
                @foreach (var actuator in actuators)
                {
                    <option value="@actuator.Id">@actuator.Id</option>
                }
            </select>
        </label>
        <label>
            Override
            <select @bind="overrideKindText">
                @foreach (var name in Enum.GetNames<CommandKind>())
                {
                    <option value="@name">@name</option>
                }
            </select>
        </label>
        <label>
            Operator note
            <input @bind="overrideNote" placeholder="optional" />
        </label>
        <div class="sx-form-actions">
            <button type="submit" disabled="@issueBusy">Issue override</button>
            <button type="button" disabled="@(issueBusy || undoBusy)" @onclick="UndoOverrideAsync">
                Undo last override
            </button>
        </div>
    </form>

    @if (issueMessage is not null)
    {
        <p class="commands-ok" role="status">@issueMessage</p>
    }
    @if (issueError is not null)
    {
        <p class="commands-error" role="alert">@issueError</p>
    }

    @if (suggestions is not null)
    {
        <article class="commands-panel commands-insights">
            <h2>Suggested Actions / Automated Insights</h2>
            <p class="commands-empty">
                Pattern-scored from operator search history and manual commands
                (@suggestions.SearchHistoryCount searches, @suggestions.SequencePairCount sequence pairs) —
                not random tips.
            </p>
            @if (suggestions.Suggestions.Count == 0)
            {
                <p class="commands-empty">No insights yet. Apply filters or issue overrides to train the engine.</p>
            }
            else
            {
                <ul class="commands-suggestions">
                    @foreach (var item in suggestions.Suggestions)
                    {
                        <li>
                            <div>
                                <strong>@item.Title</strong>
                                <span class="commands-score">score @item.Score · @item.Kind</span>
                                <p>@item.Detail</p>
                            </div>
                            @if (item.SuggestedCommand is { } cmd && !string.IsNullOrWhiteSpace(item.RelatedDeviceId))
                            {
                                <button type="button" class="commands-refresh"
                                        @onclick="() => ApplySuggestion(item.RelatedDeviceId!, cmd)">
                                    Use @cmd on @item.RelatedDeviceId
                                </button>
                            }
                        </li>
                    }
                </ul>
            }
        </article>
    }

    @if (loadError is not null)
    {
        <p class="commands-error" role="alert">@loadError</p>
    }
    else if (snapshot is null)
    {
        <p>Loading stream snapshot…</p>
    }
    else
    {
        <div class="kpi-grid">
            <article class="kpi">
                <span class="kpi-label">FIFO depth</span>
                <span class="kpi-value">@snapshot.StandardQueueDepth</span>
                <span class="kpi-label">peak @snapshot.StandardQueuePeakDepth</span>
            </article>
            <article class="kpi kpi-alert">
                <span class="kpi-label">Priority depth</span>
                <span class="kpi-value">@snapshot.PriorityQueueDepth</span>
            </article>
            <article class="kpi">
                <span class="kpi-label">Undo stack</span>
                <span class="kpi-value">@snapshot.UndoStackDepth</span>
            </article>
            <article class="kpi kpi-stale">
                <span class="kpi-label">Unique active alerts</span>
                <span class="kpi-value">@snapshot.UniqueActiveAlertCount</span>
            </article>
        </div>

        <div class="commands-panels">
            <article class="commands-panel">
                <h2>Processing timestamps</h2>
                <dl class="commands-meta">
                    <div>
                        <dt>Last FIFO dequeue</dt>
                        <dd>@(snapshot.LastStandardProcessedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Last priority dequeue</dt>
                        <dd>@(snapshot.LastPriorityProcessedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Last priority bypass</dt>
                        <dd>@(snapshot.LastPriorityBypassReason ?? "—")</dd>
                    </div>
                </dl>
            </article>

            <article class="commands-panel">
                <h2>Unique active keys (HashSet)</h2>
                @if (snapshot.UniqueActiveAlertKeys.Count == 0)
                {
                    <p class="commands-empty">No unique disconnect/error keys active.</p>
                }
                else
                {
                    <ul class="commands-keys">
                        @foreach (var key in snapshot.UniqueActiveAlertKeys)
                        {
                            <li><code>@key</code></li>
                        }
                    </ul>
                }
            </article>
        </div>

        <article class="commands-panel commands-panel-wide">
            <h2>Filtered devices (@filteredDevices.Count)</h2>
            <p class="commands-empty">Category and health filters run on the API; alert-state narrows the subset here.</p>
            @if (filteredDevices.Count == 0)
            {
                <p class="commands-empty">No devices match this filter.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="commands-table">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Category</th>
                                <th>Health</th>
                                <th>Freshness</th>
                                <th>Unique alert</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sensor in filteredDevices)
                            {
                                <tr>
                                    <td><a href="telemetry/devices/@sensor.Id">@sensor.Id</a></td>
                                    <td>@sensor.Category</td>
                                    <td><StateChip Health="sensor.Health" /></td>
                                    <td><StateChip Freshness="sensor.Freshness" /></td>
                                    <td>@(HasUniqueAlert(sensor.Id) ? "yes" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <article class="commands-panel commands-panel-wide">
            <h2>Recent priority alerts</h2>
            @if (snapshot.RecentAlerts.Count == 0)
            {
                <p class="commands-empty">No processed priority alerts yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="commands-table">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Severity</th>
                                <th>Reason</th>
                                <th>Raised</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in snapshot.RecentAlerts.AsEnumerable().Reverse())
                            {
                                <tr>
                                    <td>@alert.DeviceId</td>
                                    <td>@alert.Severity</td>
                                    <td>@alert.Reason</td>
                                    <td>@alert.RaisedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <article class="commands-panel commands-panel-wide">
            <h2>Command / alert timeline (@(timeline?.TotalCount ?? 0))</h2>
            <p class="commands-empty">
                SortedDictionary history (oldest → newest). Overrides and priority alerts only —
                not the full Part 1 telemetry fleet dump.
            </p>
            @if (timeline is null || timeline.Entries.Count == 0)
            {
                <p class="commands-empty">No timeline entries yet. Issue an override or wait for a priority alert.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="commands-table">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Kind</th>
                                <th>Device</th>
                                <th>Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in timeline.Entries)
                            {
                                <tr>
                                    <td>@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td>@entry.Kind</td>
                                    <td>@entry.DeviceId</td>
                                    <td>@entry.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (snapshot.RecentCommands.Count > 0)
            {
                <h3 class="commands-subhead">Undo stack (newest first)</h3>
                <div class="table-wrap">
                    <table class="commands-table">
                        <thead>
                            <tr>
                                <th>Device</th>
                                <th>Kind</th>
                                <th>Target</th>
                                <th>Issued</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var command in snapshot.RecentCommands)
                            {
                                <tr>
                                    <td>@command.DeviceId</td>
                                    <td>@command.Kind</td>
                                    <td>@(command.TargetIsActive ? "active" : "inactive")</td>
                                    <td>@command.IssuedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }

    <p class="commands-ops">
        <a href="telemetry">Fleet overview</a>
        ·
        <a href="">Startup menu</a>
        ·
        <button type="button" class="commands-refresh" @onclick="ReloadAsync">Refresh</button>
    </p>
</section>

@code {
    private StreamSnapshotResponse? snapshot;
    private TimelineHistoryResponse? timeline;
    private SuggestionsResponse? suggestions;
    private List<SensorResponse> filteredDevices = [];
    private List<SensorResponse> actuators = [];
    private string? loadError;

    private string categoryText = string.Empty;
    private string healthText = string.Empty;
    private string alertScope = "any";

    private string overrideDeviceId = "sx-act-rack2-valve";
    private string overrideKindText = nameof(CommandKind.CloseValve);
    private string overrideNote = string.Empty;
    private bool issueBusy;
    private bool undoBusy;
    private string? issueMessage;
    private string? issueError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ClearFiltersAsync()
    {
        categoryText = string.Empty;
        healthText = string.Empty;
        alertScope = "any";
        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        if (snapshot is null && loadError is null)
        {
            await ReloadAsync();
            return;
        }

        await LoadFilteredDevicesAsync();
        await RecordSearchAsync();
        await LoadSuggestionsAsync();
    }

    private void ApplySuggestion(string deviceId, CommandKind kind)
    {
        overrideDeviceId = deviceId;
        overrideKindText = kind.ToString();
        issueMessage = $"Suggestion applied: {kind} on {deviceId}. Click Issue override to send it.";
        issueError = null;
    }

    private async Task RecordSearchAsync()
    {
        try
        {
            var related = filteredDevices.FirstOrDefault(sensor => HasUniqueAlert(sensor.Id))?.Id
                          ?? filteredDevices.FirstOrDefault()?.Id;

            var request = new RecordSearchRequest
            {
                CategoryFilter = string.IsNullOrWhiteSpace(categoryText) ? null : categoryText,
                HealthFilter = string.IsNullOrWhiteSpace(healthText) ? null : healthText,
                AlertScope = alertScope,
                RelatedDeviceId = related
            };

            await Http.PostAsJsonAsync("api/stream/searches", request, GatewayJson.Options);
        }
        catch
        {
            // Search logging is best-effort; filters still apply.
        }
    }

    private async Task LoadSuggestionsAsync()
    {
        try
        {
            suggestions = await Http.GetFromJsonAsync<SuggestionsResponse>("api/stream/suggestions", GatewayJson.Options);
        }
        catch
        {
            suggestions = null;
        }
    }

    private async Task IssueOverrideAsync()
    {
        issueMessage = null;
        issueError = null;

        if (string.IsNullOrWhiteSpace(overrideDeviceId))
        {
            issueError = "Select an actuator before issuing an override.";
            return;
        }

        if (!Enum.TryParse<CommandKind>(overrideKindText, ignoreCase: true, out var kind))
        {
            issueError = "Command kind is not recognised.";
            return;
        }

        issueBusy = true;
        try
        {
            var request = new IssueCommandRequest
            {
                DeviceId = overrideDeviceId.Trim(),
                Kind = kind,
                OperatorNote = string.IsNullOrWhiteSpace(overrideNote) ? null : overrideNote.Trim()
            };

            using var response = await Http.PostAsJsonAsync("api/commands", request, GatewayJson.Options);
            var payload = await response.Content.ReadFromJsonAsync<IssueCommandResponse>(GatewayJson.Options);

            if (payload is null)
            {
                issueError = "Gateway returned an empty override response.";
                return;
            }

            if (!payload.Succeeded)
            {
                issueError = string.Join(" ", payload.Errors);
                return;
            }

            issueMessage =
                $"Issued {payload.Command?.Kind} on {payload.Command?.DeviceId} " +
                $"(target {(payload.Command?.TargetIsActive == true ? "active" : "inactive")}).";
            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            issueError = "Gateway unreachable. Start SmartX.Api and try again.";
        }
        catch (Exception)
        {
            issueError = "The override could not be issued.";
        }
        finally
        {
            issueBusy = false;
        }
    }

    private async Task UndoOverrideAsync()
    {
        issueMessage = null;
        issueError = null;
        undoBusy = true;
        try
        {
            using var response = await Http.PostAsync("api/commands/undo", null);
            var payload = await response.Content.ReadFromJsonAsync<UndoCommandResponse>(GatewayJson.Options);

            if (payload is null)
            {
                issueError = "Gateway returned an empty undo response.";
                return;
            }

            if (!payload.Succeeded)
            {
                issueError = string.Join(" ", payload.Errors);
                return;
            }

            issueMessage =
                $"Undid {payload.UndoneCommand?.Kind} on {payload.UndoneCommand?.DeviceId} " +
                $"(restored {(payload.UndoneCommand?.PreviousIsActive == true ? "active" : payload.UndoneCommand?.PreviousIsActive == false ? "inactive" : "unset")}).";
            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            issueError = "Gateway unreachable. Start SmartX.Api and try again.";
        }
        catch (Exception)
        {
            issueError = "The undo request failed.";
        }
        finally
        {
            undoBusy = false;
        }
    }

    private async Task ReloadAsync()
    {
        loadError = null;
        try
        {
            snapshot = await Http.GetFromJsonAsync<StreamSnapshotResponse>("api/stream/snapshot", GatewayJson.Options);
            timeline = await Http.GetFromJsonAsync<TimelineHistoryResponse>("api/stream/timeline", GatewayJson.Options);
            var fleet = await Http.GetFromJsonAsync<SensorListResponse>("api/sensors?category=Actuator", GatewayJson.Options);
            actuators = fleet?.Sensors ?? [];
            if (actuators.Count > 0 && actuators.All(sensor => sensor.Id != overrideDeviceId))
            {
                overrideDeviceId = actuators[0].Id;
            }

            await LoadFilteredDevicesAsync();
            await LoadSuggestionsAsync();
        }
        catch (HttpRequestException)
        {
            snapshot = null;
            timeline = null;
            suggestions = null;
            filteredDevices = [];
            actuators = [];
            loadError = "Gateway unreachable. Start SmartX.Api (http://localhost:5015) and reload.";
        }
        catch (Exception)
        {
            snapshot = null;
            timeline = null;
            suggestions = null;
            filteredDevices = [];
            actuators = [];
            loadError = "The command-stream page could not be loaded from the gateway.";
        }
    }

    private async Task LoadFilteredDevicesAsync()
    {
        var list = await Http.GetFromJsonAsync<SensorListResponse>(BuildSensorUrl(), GatewayJson.Options);
        var sensors = list?.Sensors ?? [];

        filteredDevices = alertScope switch
        {
            "unique" => sensors.Where(sensor => HasUniqueAlert(sensor.Id)).ToList(),
            "attention" => sensors.Where(sensor => sensor.Health is not HealthState.Normal).ToList(),
            _ => sensors
        };
    }

    private bool HasUniqueAlert(string deviceId)
    {
        if (snapshot is null || string.IsNullOrWhiteSpace(deviceId))
        {
            return false;
        }

        var needle = deviceId.Trim();
        return snapshot.UniqueActiveAlertKeys.Any(key =>
            key.Contains($":{needle}:", StringComparison.OrdinalIgnoreCase)
            || key.EndsWith($":{needle}", StringComparison.OrdinalIgnoreCase)
            || key.Contains($"disconnect:{needle}", StringComparison.OrdinalIgnoreCase));
    }

    private string BuildSensorUrl()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(categoryText))
        {
            query.Add("category=" + Uri.EscapeDataString(categoryText.Trim()));
        }

        if (!string.IsNullOrWhiteSpace(healthText))
        {
            query.Add("health=" + Uri.EscapeDataString(healthText.Trim()));
        }

        return query.Count == 0 ? "api/sensors" : "api/sensors?" + string.Join("&", query);
    }
}
